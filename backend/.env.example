# App
APP_NAME=gamegen
APP_VERSION=0.1.0

# HTTP
HTTP_PORT=8080
HTTP_READ_TIMEOUT=30s
# 0s — write timeout выключен: SSE-поток долгоживущий
HTTP_WRITE_TIMEOUT=0s
HTTP_IDLE_TIMEOUT=120s
HTTP_SHUTDOWN_TIMEOUT=10s

# Logger
LOG_LEVEL=info
LOG_FORMAT=console

# Postgres
POSTGRES_DSN=postgres://bee:12345@localhost:5432/bee?sslmode=disable
POSTGRES_MAX_CONNS=10
POSTGRES_MIN_CONNS=2
POSTGRES_CONNECT_TIMEOUT=5s

# LLM
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_TIMEOUT=120s
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF=2s
LLM_MAX_CALLS_PER_GAME=12
LLM_MAX_TOKENS_ANALYZER=4000
LLM_MAX_TOKENS_PLANNER=4000
LLM_MAX_TOKENS_CODER=16000
LLM_MAX_TOKENS_ASSETS=8000
LLM_MAX_TOKENS_REVIEWER=4000
LLM_MAX_TOKENS_ASSEMBLER=8000
LLM_MAX_TOKENS_PATCH=16000
LLM_MAX_TOKENS_REPAIR=16000

# Tokens
TOKENS_GRANT_SIGNUP=1000000
TOKENS_GRANT_TOPUP=500000
TOKENS_PRICE_GENERATE=320000
TOKENS_PRICE_PATCH=40000

# Worker
GENERATION_CONCURRENCY=2
GENERATION_TIMEOUT=300s
GENERATION_MAX_FIX_ATTEMPTS=2

# Kafka
KAFKA_BROKERS=localhost:9094
KAFKA_TOPIC=game.events
KAFKA_GROUP_ID=gamegen
KAFKA_WRITE_TIMEOUT=10s
KAFKA_READ_TIMEOUT=10s

# Auth
BCRYPT_COST=10

# Validator
# Пусто — node ищется в PATH; без node проверка синтаксиса JS пропускается
NODE_PATH=
