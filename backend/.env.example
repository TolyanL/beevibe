# App
APP_NAME=gamegen
APP_VERSION=0.1.0

# HTTP
HTTP_PORT=8080
HTTP_READ_TIMEOUT=30s
# 0s disables the write timeout: the SSE stream stays open for the whole generation
HTTP_WRITE_TIMEOUT=0s
HTTP_IDLE_TIMEOUT=120s
HTTP_SHUTDOWN_TIMEOUT=10s

# Logger
LOG_LEVEL=info
LOG_FORMAT=console

# Postgres
POSTGRES_DSN=postgres://bee:12345@localhost:5432/bee?sslmode=disable
POSTGRES_MAX_CONNS=10
POSTGRES_MIN_CONNS=2
POSTGRES_CONNECT_TIMEOUT=5s

# LLM
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_TIMEOUT=120s
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF=2s
LLM_MAX_CALLS_PER_GAME=12

# No response length limit: max_tokens is not sent, the effort level decides
# how long the answer is.

# Reasoning effort per request: default | none | minimal | low | medium | high | xhigh | max
# default does not send the field, the provider default applies.
# WARN: some OpenAI models answer 400 on none/minimal, such a request is not retried.
LLM_REASONING_EFFORT_ANALYZER=default
LLM_REASONING_EFFORT_PLANNER=default
LLM_REASONING_EFFORT_CODER=default
LLM_REASONING_EFFORT_ASSETS=default
LLM_REASONING_EFFORT_REVIEWER=default
LLM_REASONING_EFFORT_ASSEMBLER=default
LLM_REASONING_EFFORT_PATCH=default
LLM_REASONING_EFFORT_REPAIR=default

# Dialect of the effort field: openrouter sends "reasoning": {"effort": ...},
# openai sends "reasoning_effort": ... (OpenAI Chat Completions and llama.cpp,
# none turns the thinking off).
LLM_REASONING_DIALECT=openrouter

# Empty disables the dump; otherwise a directory for the req/resp/meta of every attempt.
LLM_DEBUG_DIR=

# Tokens
TOKENS_GRANT_SIGNUP=1000000
TOKENS_GRANT_TOPUP=500000
TOKENS_PRICE_GENERATE=320000
TOKENS_PRICE_PATCH=40000

# Worker
GENERATION_CONCURRENCY=2
GENERATION_TIMEOUT=300s
GENERATION_MAX_FIX_ATTEMPTS=2

# Kafka
KAFKA_BROKERS=localhost:9094
KAFKA_TOPIC=game.events
KAFKA_GROUP_ID=gamegen
KAFKA_WRITE_TIMEOUT=10s
KAFKA_READ_TIMEOUT=10s

# Auth
BCRYPT_COST=10

# Validator
# Empty looks up node in PATH; without node the JS syntax check is skipped
NODE_PATH=
